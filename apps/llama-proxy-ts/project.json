{
  "name": "llama-proxy-ts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/llama-proxy-ts/src",
  "projectType": "application",
  "tags": ["scope:app", "scope:backend", "lang:typescript"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx --tsconfig ../../tsconfig.base.json src/main.ts",
        "cwd": "apps/llama-proxy-ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.app.json",
        "cwd": "apps/llama-proxy-ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/llama-proxy-ts/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
